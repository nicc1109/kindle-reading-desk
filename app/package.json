{
  "name": "kindle-reading-desk",
  "version": "0.2.7",
  "description": "A local-first Kindle clippings companion for Obsidian",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "npm run build:electron && concurrently -k \"vite --host 0.0.0.0\" \"npm:electron:dev\"",
    "electron:dev": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/electron/main.js",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/copy-electron-assets.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron && node scripts/prepare-sites-build.mjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:release": "npm run build && electron-builder --win nsis --publish never",
    "preview": "vite preview",
    "test": "node scripts/run-vitest.mjs",
    "capture:qa": "electron scripts/capture-electron.mjs",
    "capture:browser": "node scripts/capture-browser.mjs",
    "qa:windows": "node scripts/qa-windows.mjs",
    "compare:qa": "node scripts/compare-images.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.5",
    "@fontsource/newsreader": "5.2.5",
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "chokidar": "4.0.3",
    "electron-updater": "6.6.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "yaml": "2.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.21",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "concurrently": "9.2.0",
    "cross-env": "7.0.3",
    "electron": "36.4.0",
    "electron-builder": "26.0.12",
    "jsdom": "26.1.0",
    "playwright": "1.55.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "wait-on": "8.0.3"
  },
  "build": {
    "appId": "com.readingdesk.kindle",
    "productName": "Reading Desk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nicc1109",
        "repo": "kindle-reading-desk",
        "releaseType": "release"
      }
    ]
  },
  "author": "Reading Desk"
}
